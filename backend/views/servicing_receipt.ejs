<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Servicing Dispatch Challan - SR-<%= ticketId %></title>
    <style>
        <%- fontsCss %>
        
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            color: #1e293b;
            background-color: #ffffff;
            line-height: 1.4;
            padding: 10px;
            font-size: 12px;
        }

        .report-container {
            max-width: 800px;
            margin: 0 auto;
        }

        /* Header Styling */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            border-bottom: 3px solid #06b6d4; /* Cyan border */
            padding-bottom: 10px;
            margin-bottom: 12px;
        }

        .brand-section h1 {
            font-size: 24px;
            font-weight: 800;
            color: #0891b2; /* Cyan dark */
            letter-spacing: -0.025em;
            text-transform: uppercase;
        }

        .brand-section p {
            font-size: 11px;
            color: #475569;
            margin-top: 2px;
        }

        .brand-section .meta-date {
            font-size: 10px;
            color: #94a3b8;
            margin-top: 6px;
        }

        .ticket-section {
            text-align: right;
        }

        .ticket-section h2 {
            font-size: 16px;
            font-weight: 700;
            color: #0f172a;
            letter-spacing: 0.05em;
        }

        .ticket-section .ticket-id {
            font-family: monospace;
            font-size: 15px;
            font-weight: 700;
            color: #0891b2;
            margin-top: 2px;
        }

        .ticket-section .status-badge {
            display: inline-block;
            margin-top: 8px;
            padding: 3px 10px;
            border-radius: 9999px;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            background-color: #ecfeff;
            color: #0891b2;
            border: 1px solid #c5f2f7;
        }

        /* Dispatch details banner */
        .dispatch-banner {
            background-color: #ecfeff;
            border: 1px solid #a5f3fc;
            color: #0e7490;
            border-radius: 6px;
            padding: 10px 14px;
            margin-bottom: 12px;
            display: flex;
            justify-content: space-between;
            gap: 12px;
            align-items: center;
        }

        .dispatch-banner-item {
            display: flex;
            flex-direction: column;
        }

        .dispatch-banner-label {
            font-size: 9px;
            text-transform: uppercase;
            font-weight: 700;
            color: #0891b2;
            letter-spacing: 0.05em;
        }

        .dispatch-banner-value {
            font-size: 13px;
            font-weight: 600;
            color: #0f172a;
            margin-top: 2px;
        }

        /* Grid for details */
        .details-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-bottom: 12px;
        }

        .details-card {
            background-color: #f8fafc;
            border: 1px solid #f1f5f9;
            border-radius: 6px;
            padding: 10px;
        }

        .details-card h3 {
            font-size: 11px;
            font-weight: 700;
            color: #0891b2;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 8px;
            border-bottom: 1px solid #e2e8f0;
            padding-bottom: 4px;
        }

        .info-group {
            margin-bottom: 6px;
        }

        .info-group:last-child {
            margin-bottom: 0;
        }

        .info-label {
            font-size: 10px;
            font-weight: 600;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 0.025em;
        }

        .info-value {
            font-size: 12px;
            font-weight: 500;
            color: #0f172a;
            margin-top: 2px;
            white-space: pre-wrap;
        }

        .info-value.mono {
            font-family: monospace;
            font-size: 11px;
        }

        .problem-desc-box {
            font-size: 11px;
            color: #334155;
            background-color: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 6px;
            padding: 6px 10px;
            min-height: 40px;
            margin-top: 4px;
            white-space: pre-wrap;
        }

        /* Checklist Table */
        .items-section {
            margin-bottom: 16px;
        }

        .items-section h3 {
            font-size: 11px;
            font-weight: 700;
            color: #0891b2;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 6px;
        }

        .items-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 11px;
            border: 1px solid #e2e8f0;
            border-radius: 6px;
            overflow: hidden;
        }

        .items-table th {
            background-color: #f1f5f9;
            color: #475569;
            font-weight: 700;
            text-align: left;
            padding: 6px 10px;
            border-bottom: 1px solid #e2e8f0;
        }

        .items-table td {
            padding: 6px 10px;
            border-bottom: 1px solid #e2e8f0;
            color: #334155;
        }

        .items-table tr:last-child td {
            border-bottom: none;
        }

        .items-table td.item-name {
            font-weight: 600;
            color: #0f172a;
            width: 30%;
        }

        .items-table td.item-desc {
            color: #475569;
        }

        .items-table .italic-muted {
            font-style: italic;
            color: #94a3b8;
        }

        .status-pill {
            display: inline-block;
            font-size: 9px;
            font-weight: 700;
            padding: 1px 6px;
            border-radius: 4px;
            text-transform: uppercase;
        }

        .status-sent {
            background-color: #ecfeff;
            color: #0891b2;
            border: 1px solid #a5f3fc;
        }

        .status-not-sent {
            background-color: #f8fafc;
            color: #64748b;
            border: 1px solid #cbd5e1;
        }

        /* Signatures */
        .signature-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
            margin-top: 40px;
            page-break-inside: avoid;
        }

        .signature-line {
            border-top: 1px solid #0f172a;
            padding-top: 6px;
            text-align: center;
            font-size: 11px;
            font-weight: 600;
            color: #475569;
        }

        /* Footer Metadata */
        .footer-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 9px;
            color: #94a3b8;
            border-top: 1px dotted #e2e8f0;
            padding-top: 8px;
            margin-top: 30px;
        }
    </style>
</head>
<body>
    <div class="report-container">
        <!-- Header -->
        <div class="header">
            <div class="brand-section">
                <h1>RADHA IT SOLUTION & SERVICES</h1>
                <p>GANGARAMPUR<br>BARABAZAR<br>DAKSHIN DINAJPUR<br>PH - 9332554299<br>EMAIL - radheitsolutionservices@gmail.com</p>
                <div class="meta-date">Date Printed: <%= generatedAt %></div>
            </div>
            <div class="ticket-section">
                <h2>SERVICING DISPATCH CHALLAN</h2>
                <div class="ticket-id">#SR-<%= ticketId %></div>
                <span class="status-badge">OUTWARD CHALLAN</span>
            </div>
        </div>

        <!-- Dispatch Information Banner -->
        <div class="dispatch-banner">
            <div class="dispatch-banner-item">
                <span class="dispatch-banner-label">Challan No.</span>
                <span class="dispatch-banner-value"><%= request.challan_no || 'N/A' %></span>
            </div>
            <div class="dispatch-banner-item">
                <span class="dispatch-banner-label">Dispatch Date</span>
                <span class="dispatch-banner-value">
                    <%= request.dispatch_date ? new Date(request.dispatch_date).toLocaleDateString("en-GB") : 'N/A' %>
                </span>
            </div>
            <div class="dispatch-banner-item" style="flex-grow: 1;">
                <span class="dispatch-banner-label">Courier & Transport Details</span>
                <span class="dispatch-banner-value"><%= request.courier_details || 'Hand Delivery / Self' %></span>
            </div>
        </div>

        <!-- Details Grid -->
        <div class="details-grid">
            <!-- Product Specs -->
            <div class="details-card">
                <h3>Product Specifications</h3>
                <div class="info-group">
                    <div class="info-label">Device model & type</div>
                    <div class="info-value"><%= request.brand_model %> (<%= request.device_type %>)</div>
                </div>
                <div class="info-group">
                    <div class="info-label">Serial Number (S/N)</div>
                    <div class="info-value mono"><%= request.serial_number || 'N/A' %></div>
                </div>
                <div class="info-group" style="display: flex; align-items: center; gap: 6px;">
                    <div class="info-label" style="margin-bottom: 0;">Is In Warranty?</div>
                    <div class="info-value" style="margin-top: 0;"><%= (request.is_warranty === 1 || request.is_warranty === true) ? 'Yes' : 'No' %></div>
                </div>
                <div class="info-group">
                    <div class="info-label">Problem / Service Required</div>
                    <div class="problem-desc-box"><%= request.problem_description || 'General Service / Inspected Faults.' %></div>
                </div>
            </div>

            <!-- Destination Service Center Details -->
            <div class="details-card">
                <h3>Service Center / Destination</h3>
                <div class="info-group">
                    <div class="info-label">Service Partner Name</div>
                    <div class="info-value" style="font-weight: 700; color: #0891b2;"><%= request.company_name || 'N/A' %></div>
                </div>
                <div class="info-group">
                    <div class="info-label">Contact Mobile</div>
                    <div class="info-value"><%= request.company_mobile || 'N/A' %></div>
                </div>
                <div class="info-group">
                    <div class="info-label">Address</div>
                    <div class="info-value"><%= request.company_address || 'N/A' %></div>
                </div>
            </div>
        </div>

        <!-- Checklist of Items Received & Sent -->
        <div class="items-section">
            <h3>Checklist of Associated Accessories</h3>
            <table class="items-table">
                <thead>
                    <tr>
                        <th style="width: 25%;">Item Name</th>
                        <th style="width: 35%;">Specifications / Condition</th>
                        <th style="width: 15%; text-align: center;">Sent to Center?</th>
                        <th style="width: 25%;">Servicing Problem Description</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (request.items && request.items.length > 0) { %>
                        <% request.items.forEach(function(item) { %>
                            <tr>
                                <td class="item-name"><%= item.item_name %></td>
                                <td class="item-desc"><%= item.item_description || 'Verified' %></td>
                                <td style="text-align: center;">
                                    <% if (item.sent_for_servicing === 1 || item.sent_for_servicing === true) { %>
                                        <span class="status-pill status-sent">Yes</span>
                                    <% } else { %>
                                        <span class="status-pill status-not-sent">No</span>
                                    <% } %>
                                </td>
                                <td>
                                    <%= item.servicing_problem_description || (item.sent_for_servicing === 1 ? 'Refer to main issue' : 'Kept at intake store') %>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="4" class="italic-muted" style="text-align: center; padding: 20px;">
                                No standalone accessories or chargers dispatched.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <!-- Signatures -->
        <div class="signature-grid">
            <div class="signature-line">Authorized Dispatcher Signature</div>
            <div class="signature-line">Service Center Acknowledgment & Received By</div>
        </div>

        <!-- Footer -->
        <div class="footer-meta">
            <span>Dispatched by User: <strong><%= registeredBy %></strong></span>
            <span>Ticket ID: #SR-<%= ticketId %></span>
        </div>
    </div>
    <script>
        // Auto-print fallback for non-Electron environment (browser web mode)
        if (typeof window !== "undefined" && (!window.electronAPI || !window.electronAPI.isElectron)) {
            window.onload = () => {
                setTimeout(() => {
                    window.print();
                }, 500);
            };
        }
    </script>
</body>
</html>
